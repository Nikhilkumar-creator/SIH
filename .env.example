# ============ Supabase (shared project) ============
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # backend only — NEVER expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret                  # Project Settings -> API -> JWT Secret

# Frontend (Vite requires the VITE_ prefix; these are safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============ Local Ollama ============
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# ============ Backend app config ============
ENV=development                 # development | test | production
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173
